{
  "baseline_caps": {
    "duplicate_top_files_per_zone": 20,
    "duplicate_top_files_project": 200,
    "hard_time_budget_seconds": 120,
    "max_bytes_per_text_file": 262144,
    "max_content_sampled_files": 20000,
    "soft_time_budget_seconds": 60,
    "structural_top_files_per_zone": 50,
    "total_content_read_bytes": 67108864
  },
  "dedupe": {
    "key_fields": [
      "normalized_affected_files",
      "normalized_root_cause",
      "primary_lane"
    ],
    "related_lane_policy": "Use one finding per root cause. Put overlapping concerns in related_lanes."
  },
  "lane_priority": [
    "security-risk",
    "correctness-edge-case",
    "performance-efficiency",
    "resource-lifecycle",
    "concurrency-state-safety",
    "error-handling-recovery",
    "reinvented-capability",
    "dependency-risk",
    "authority-drift",
    "type-contract-safety",
    "dynamic-usage",
    "test-reliability",
    "dead-code",
    "duplicate-logic",
    "structural-quality"
  ],
  "lanes": {
    "authority-drift": {
      "default_risk_floor": 4,
      "finding_category": "authority-drift",
      "implementation_policy": "human-approval",
      "required_evidence": [
        "root_cause",
        "authorities_compared",
        "contradiction",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Compare existing docs, tests, schemas, and public contracts only."
      ]
    },
    "concurrency-state-safety": {
      "default_risk_floor": 4,
      "finding_category": "concurrency-state-safety",
      "implementation_policy": "human-approval",
      "required_evidence": [
        "root_cause",
        "shared_state",
        "race_or_ordering",
        "trigger_interleaving",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Check race conditions, shared mutable state, non-atomic writes, lock ordering, async tasks without await or cancel handling.",
        "Treat as high blast radius; require human approval before implementation."
      ]
    },
    "correctness-edge-case": {
      "default_risk_floor": 2,
      "finding_category": "correctness-edge-case",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "trigger_condition",
        "failure_mode",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Probe existing inputs: empty, null/None, missing keys, wrong types, large numbers, timezone/DST, Unicode, path separators, partial failures.",
        "Report a concrete failure path, not style; include data-integrity risks like non-atomic writes or duplicate IDs."
      ]
    },
    "dead-code": {
      "default_risk_floor": 2,
      "finding_category": "dead-code",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "reachability_summary",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Use existing references, entrypoints, configs, tests, and runtime evidence gates."
      ]
    },
    "dependency-risk": {
      "default_risk_floor": 4,
      "finding_category": "dependency-risk",
      "implementation_policy": "human-approval",
      "required_evidence": [
        "root_cause",
        "dependency_files_checked",
        "usage_or_lockfile_evidence",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Use existing lockfiles and existing package-manager output only."
      ]
    },
    "duplicate-logic": {
      "default_risk_floor": 2,
      "finding_category": "duplicate-logic",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "duplicate_locations",
        "equivalence_reason",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Use bounded normalized-block or repeated-shape evidence; no new clone scanner required."
      ]
    },
    "dynamic-usage": {
      "default_risk_floor": 4,
      "finding_category": "dynamic-usage",
      "implementation_policy": "human-approval",
      "required_evidence": [
        "root_cause",
        "dynamic_mechanism",
        "entrypoints_or_configs",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Check existing reflection, registry, config, plugin, eval, and exec paths; include configuration-footgun signals like cwd/platform dependence or path-separator mismatch."
      ]
    },
    "error-handling-recovery": {
      "default_risk_floor": 3,
      "finding_category": "error-handling-recovery",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "swallow_or_recovery_gap",
        "affected_behavior",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Check swallowed exceptions, broad except, silent fallback, lost root cause, incorrect rollback after partial write, and unstructured errors that block diagnosis.",
        "Tie each gap to a concrete failure or debugging cost."
      ]
    },
    "performance-efficiency": {
      "default_risk_floor": 2,
      "finding_category": "performance-efficiency",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "hotspot_location",
        "cost_signal",
        "cheaper_alternative",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Look for algorithmic complexity, redundant loops, repeated I/O/DB/API calls, N+1, missing batching/caching, heavy serialization or re-parsing, and slow build/test flows.",
        "Cost must be measurable or clearly explained; name a cheaper existing approach."
      ]
    },
    "reinvented-capability": {
      "default_risk_floor": 2,
      "finding_category": "reinvented-capability",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "reinvented_behavior",
        "existing_alternative",
        "equivalence_risk",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Flag hand-rolled parsers, retry, date/path/glob handling, validation, crypto, caching, diffing, or CLI parsing where a stdlib or existing mature dependency is safer.",
        "Confirm an already-available alternative; do not invent new dependencies casually."
      ]
    },
    "resource-lifecycle": {
      "default_risk_floor": 3,
      "finding_category": "resource-lifecycle",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "resource_type",
        "leak_or_exhaustion_path",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Check unclosed files/sockets/handles, memory leaks, unbounded queues/caches, and missing timeout/cancellation/retry budget.",
        "Use existing code paths; no new profilers required."
      ]
    },
    "security-risk": {
      "default_risk_floor": 5,
      "finding_category": "security-risk",
      "implementation_policy": "blocked-direct",
      "required_evidence": [
        "root_cause",
        "threat_or_secret",
        "exposure_path",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Use existing project evidence only; do not install scanners."
      ]
    },
    "structural-quality": {
      "default_risk_floor": 2,
      "finding_category": "structural-quality",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "objective_signals",
        "impact",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Start with LOC, rough branch counts, ownership concentration, and coupling signals."
      ]
    },
    "test-reliability": {
      "default_risk_floor": 3,
      "finding_category": "test-reliability",
      "implementation_policy": "packet-ok",
      "required_evidence": [
        "root_cause",
        "test_gap",
        "affected_behavior",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Focus on missing tests for a risky hotspot or edge case that can actually break, not the absence of tests in general."
      ]
    },
    "type-contract-safety": {
      "default_risk_floor": 4,
      "finding_category": "type-contract-safety",
      "implementation_policy": "human-approval",
      "required_evidence": [
        "root_cause",
        "boundary_or_contract",
        "unchecked_assumption",
        "affected_files",
        "counterevidence_or_gap"
      ],
      "tool_hints": [
        "Check unchecked input/output at CLI args, JSON schema, public API, and plugin interface boundaries, plus casts and runtime data assumptions."
      ]
    }
  },
  "policy_order": [
    "discovery-only",
    "packet-ok",
    "human-approval",
    "blocked-direct"
  ],
  "policy_limits": {
    "max_lanes": 15,
    "max_required_evidence_fields_per_lane": 6,
    "max_tool_hints_per_lane": 2,
    "max_assigned_lanes_per_zone": 5,
    "max_zones_per_agent": 3,
    "max_agent_slots": 24,
    "max_context_tokens": 120000,
    "max_focused_tasks": 48
  },
  "schema_version": "1.0"
}
