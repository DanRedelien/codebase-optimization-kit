  "additionalProperties": true,
  "properties": {
    "affected_files": {
      "type": "array"
    },
    "category": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "contracts_touched": {
      "type": "array"
    },
    "counterevidence": {
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "dead_code": {
      "type": "object"
    },
    "evidence": {
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "recommendation": {
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "needs-evidence",
        "approved",
